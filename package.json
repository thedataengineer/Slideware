{
  "name": "slideware",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thedataengineer/Slideware.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "powerpoint",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "test": "tsc -p tsconfig.test.json && node --test \"tests/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "manifest": "node scripts/build-manifest.js",
    "start": "npm run manifest && office-addin-debugging start manifest.local.json",
    "start:desktop:powerpoint": "npm run manifest && office-addin-debugging start manifest.local.json desktop --app powerpoint",
    "stop": "npm run manifest && office-addin-debugging stop manifest.local.json",
    "validate": "npm run manifest && office-addin-manifest validate manifest.local.json",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^3.0.2",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ],
  "overrides": {
    "adm-zip": "0.6.0",
    "uuid": "11.1.1"
  },
  "description": "PowerPoint task pane add-in for aligning, arranging, branding, searching, and AI-editing decks."
}
